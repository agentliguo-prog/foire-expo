# ==============================================================
# Variables d'Environnement - Foire Garoua 2026 (Vercel & Local)
# ==============================================================

# 1. Clé API Resend (Gratuit sur https://resend.com/api-keys)
# Nécessaire pour recevoir les notifications par email à chaque soumission de formulaire
RESEND_API_KEY=re_votre_cle_api_ici

# 2. Adresse(s) email de réception des notifications
# Par défaut : ligue.entrepreneurs.garoua@gmail.com
# Astuce : Vous pouvez mettre plusieurs emails séparés par une virgule (ex: admin@gmail.com, contact@ligue.cm)
NOTIFICATION_EMAIL=ligue.entrepreneurs.garoua@gmail.com

# 3. Adresse d'expédition (Optionnel)
# Par défaut : "Foire Garoua <onboarding@resend.dev>" (pour le domaine gratuit de test Resend)
# Si vous configurez votre propre domaine dans Resend (ex: foiregaroua.cm) :
# RESEND_SENDER=Foire Garoua <contact@foiregaroua.cm>

# 4. Webhook optionnel (ex: Zapier, Make, Discord, Telegram, Google Sheets via Webhook)
# WEBHOOK_EMAIL_URL=https://hook.eu1.make.com/...
